settings.yaml
*.token
!config.example.yaml

# Local real enrollments — the committed copy is courses.example.json
seed/courses.local.json

# Sync artifacts
sync_logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
build/

# Android
android/.gradle/
android/app/build/
android/local.properties

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# stray ~ artifact
~/

# isolated worktrees
.worktrees/

# never commit config backups
config.yaml.bak*
config.yaml.bak*
web/dist-bak*/
/backups/
