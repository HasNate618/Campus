#!/usr/bin/env bash
# Pre-commit hook: block commits containing credentials, PII, or sensitive data
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FOUND=0

for file in $STAGED; do
    # Skip git hook files themselves
    if echo "$file" | grep -q "^\.githooks/"; then
        continue
    fi
    if echo "$file" | grep -q "config.yaml.bak"; then
        echo "BLOCKED: $file — config backup contains credentials"
        FOUND=1
    fi
    if echo "$file" | grep -qE "(secret|credential|auth\.json|token\.json)"; then
        echo "BLOCKED: $file — likely contains secrets"
        FOUND=1
    fi
done

for file in $STAGED; do
    # Skip git hook files themselves
    if echo "$file" | grep -q "^\.githooks/"; then
        continue
    fi
    file_type=$(file --mime-type -b "$file" 2>/dev/null || echo "text/plain")
    if echo "$file_type" | grep -qv "^text/"; then
        continue
    fi
    CONTENT=$(git show ":$file" 2>/dev/null || true)
    if echo "$CONTENT" | grep -qiE '(password|passwd|pwd)\s*[:=]\s*["\x27]?\S{4,}'; then
        if ! echo "$CONTENT" | grep -qiE '(password|passwd|pwd)\s*[:=]\s*["\x27]?(YOUR_|CHANGE_ME|example|placeholder|xxx|TODO)'; then
            echo "BLOCKED: $file — contains hardcoded password"
            FOUND=1
        fi
    fi
    if echo "$CONTENT" | grep -qE 'AKIA[0-9A-Z]{16}'; then
        echo "BLOCKED: $file — contains AWS access key"
        FOUND=1
    fi
    if echo "$CONTENT" | grep -q "BEGIN PRIVATE KEY"; then
        echo "BLOCKED: $file — contains private key"
        FOUND=1
    fi
done

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "Commit blocked. Fix the issues above and try again."
    exit 1
fi

echo "Pre-commit: no sensitive content detected"
